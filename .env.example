# NagarNiti Root Environment Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# In dev, falls back to mongodb://127.0.0.1:27017/nagarniti if not provided
MONGODB_URI=mongodb://127.0.0.1:27017/nagarniti

# JWT Authentication
JWT_SECRET=dev_jwt_secret_change_in_production_nagar_niti_2026
JWT_EXPIRES_IN=7d

# Development / Testing Mode
# When true, OTPs are printed to server console instead of sending email/sms
DEV_MODE=true

# Email Provider (Resend or Brevo)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
EMAIL_FROM=noreply@nagarniti.satara.local

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase / Google
FIREBASE_SERVICE_ACCOUNT_PATH=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
